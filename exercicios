#~ !/bin/bash

#~ Exercicio 1

echo "Calculadora"
echo " "

read -p "Digite o primeiro número: " n1
read -p "Digite o segundo número: " n2

echo " "
echo "Escolha a Operação"
echo "[ + ] soma | [ - ] subtração |[ * ] multiplicação |[ / ] divisão"
read -p "Digite a Operação desejada: " operacao

case $operacao in
	+)
	soma=$(echo "scale =2; $n1 $operacao $n2" | bc )
	echo "O Resultado de $n1 $operacao $n2 é igual a $soma"
	;;
	-)
	sub=$(echo "scale =2; $n1 $operacao $n2" | bc )
	echo "O Resultado de $n1 $operacao $n2 é igual a $sub"
	;;
	/)
	div=$(echo "scale =2; $n1 $operacao $n2" | bc )
	echo "O Resultado de $n1 $operacao $n2 é igual a $div"
	;;
	\*)
	mult=$(echo "scale =2; $n1 $operacao $n2" | bc )
	echo "O Resultado de $n1 $operacao $n2 é igual a $mult"
	;;
	*)
	echo "Operação invalida"
	;;
esac

