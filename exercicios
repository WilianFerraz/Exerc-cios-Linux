#~ Exercicio 12

read -p "Qual o nome do arquivo que deseja modificar: " arquivo
echo "Escolha uma das opções para modificar a permissão"
echo "1. Mudar a permissão manualmente"
echo "2. Colocar um modelo pré estabelicido"
read -p "Escolha uma das Opções (1-2): " opcao
if [ $opcao == 1 ]; then
	read -p "Qual a nova permissão do arquivo: " permissao
	chmod $permissao $arquivo
	echo "Permissão Modificada!"
	ls -l $arquivo
elif [ $opcao == 2 ]; then
	echo "Qual dos códigos você deseja?"
	echo "As opções são: 644 <1>, 755 <2> ou 700 <3>"
	read -p "Qual das opções você deseja? (1-3)" modelo
	if [ $modelo == 1 ]; then
		chmod 644 $arquivo
		echo "Permissão Modificada para 644!"
		ls -l $arquivo
	elif [ $modelo == 2 ]; then
		chmod 755 $arquivo
		echo "Permissão Modificada para 755!"
		ls -l $arquivo	
	elif [ $modelo == 3 ]; then
		chmod 700 $arquivo
		echo "Permissão Modificada para 700!"
		ls -l $arquivo
	
	fi
fi

