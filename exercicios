#~ Exercicio 15

read -p "Qual o Pid do processo que você deseja excluir: " pid
echo "PID informado: $pid"
read -p "Deseja encerrar o processo requerido? (s/n): " confirmar

if [ $confirmar == "s" ]; then
    if ps aux | grep -w "$pid" | grep -v grep; then
        echo "Processo encontrado!"
        kill -9 $pid
        echo "Processo Encerrado com sucesso."
    else
        echo "Erro: Esse PID não foi encontrado na lista de processos!"
    fi

elif [ $confirmar == "n" ]; then
    echo "Operação cancelada pelo usuário."
fi
