#~ Exercicio 7

echo "=== MENU DE BUSCA ==="
echo "1. Procurar um arquivo utilizando find"
echo "2. Procurar um comando utilizando whereis"
echo "3. Procurar um arquivo utilizando locate"
echo "4. Sair"
echo "====================="
read -p "Escolha uma opção (1-4): " opcao

case $opcao in
    1)
        read -p "Digite o nome do arquivo para o find (ex: script.sh): " arq_find
        echo "Buscando com find a partir do diretório atual..."
        find . -name "$arq_find"
        ;;
    2)
        read -p "Digite o nome do comando para o whereis (ex: bash, ls): " cmd_whereis
        echo "Localizando comando com whereis..."
        whereis "$cmd_whereis"
        ;;
    3)
        read -p "Digite o nome do arquivo para o locate: " arq_locate
        echo "Buscando com locate..."
        locate "$arq_locate"
        ;;
    4|*)
        echo "Saindo do script..."
        exit 0
        ;;
esac

